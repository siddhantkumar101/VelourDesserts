# Velour Desserts - Frontend Production Environment Variables
# Copy these keys into your hosting provider's (Vercel/Netlify/Render) environment variable dashboard!

# Connects the frontend to your deployed backend API URL
VITE_API_BASE_URL=https://velourdesserts.onrender.com/api/v1

# Stripe Publishable Key (Replace with your actual Stripe publishable key if using Stripe)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51PxD9xRp23jkl890dummy

# Google Maps API Key (Optional, leave blank if not using live map autocomplete)
VITE_GOOGLE_MAPS_API_KEY=

# Sentry DSN (Optional, leave blank for local development)
VITE_SENTRY_DSN=
